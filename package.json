{
  "name": "mark1light",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src tests scripts vite.config.ts",
    "build:mac:arm": "LC_ALL=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 LANG=en_US.UTF-8 bash scripts/build-macos-arm.sh",
    "build:mac:intel": "LC_ALL=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 LANG=en_US.UTF-8 bash scripts/build-macos-intel.sh",
    "test:native-bridge": "node scripts/native-bridge-check.mjs",
    "test:search": "node scripts/search-dialog-check.mjs",
    "test:tree": "node scripts/file-tree-check.mjs",
    "test:cheatsheet": "node scripts/cheatsheet-check.mjs",
    "test:menu": "node scripts/app-menu-check.mjs",
    "test:shortcuts": "node scripts/shortcuts-check.mjs",
    "test:tabs": "node scripts/tab-context-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:mac:arm": "node scripts/package-macos-dmg.mjs",
    "package:mac:intel": "node scripts/package-macos-dmg.mjs x64",
    "site:dev": "node scripts/site-preview.mjs --port 5180",
    "site:check": "node scripts/check-download-page.mjs",
    "android:prepare": "npm run build",
    "android:build": "bash scripts/build-android.sh",
    "test:android": "node scripts/android-check.mjs",
    "test:android:layout": "node scripts/android-layout-check.mjs",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "test:android:open": "node scripts/android-open-intent-check.mjs",
    "test:desktop": "node scripts/desktop-features-check.mjs",
    "test:updater": "node scripts/updater-check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
